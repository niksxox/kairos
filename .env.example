# KAIROS Environment Configuration Example
# Copy to .env if customizing local execution defaults

# Web Application
KAIROS_PORT=8501
KAIROS_HOST=0.0.0.0

# REST API & OpenAPI Documentation
KAIROS_API_PORT=8000
KAIROS_API_HOST=0.0.0.0

# Mathematical Solver & Concurrency
KAIROS_SOLVER_WORKERS=4
KAIROS_TIME_LIMIT_SECONDS=15

# Persistent Database
KAIROS_DB_PATH=data/campus_space.db
